<Pane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.pole_chudes.GamePageController">
        <Pane fx:id="wheelPane" />

        <HBox alignment="CENTER" spacing="50">
                <VBox>
                        <Label text="Player One" />
                        <HBox alignment="CENTER">
                                <Label fx:id="pla1" />
                        </HBox>
                </VBox>
                <VBox>
                        <Label text="Player Two" />
                        <HBox alignment="CENTER">
                                <Label fx:id="pla2" />
                        </HBox>
                </VBox>
                <VBox>
                        <Label text="Player Three" />
                        <HBox alignment="CENTER">
                                <Label fx:id="pla3" />
                        </HBox>
                </VBox>
        </HBox>

        <HBox alignment="CENTER">
        </HBox>

        <Pane fx:id="definitionContainer">
                <Label fx:id="definition" />
        </Pane>

    <Pane fx:id="arrowPane" />
    <GridPane fx:id="lettersPlace" />
    <GridPane fx:id="wordPlace"
    prefWidth="840"
    />
    <Pane fx:id="curtainPane" />
</Pane>
